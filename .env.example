# Free cloud option for the first version. Get the key in Google AI Studio.
LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local option. Requires the Ollama desktop app and a downloaded model.
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_PREDICT=500
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT=45
OLLAMA_HISTORY_MESSAGES=10

# Optional paid backend. Leave blank when using Ollama locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
